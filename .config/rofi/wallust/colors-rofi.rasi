 /* wallust template - colors-rofi */

* {
active-background: #946B8F;
active-foreground: #B9B3F5;
normal-background: #000103;
normal-foreground: #B9B3F5;
urgent-background: #8C7198;
urgent-foreground: #B9B3F5;

alternate-active-background: #A0637A;
alternate-active-foreground: #B9B3F5;
alternate-normal-background: #000103;
alternate-normal-foreground: #B9B3F5;
alternate-urgent-background: #000103;
alternate-urgent-foreground: #B9B3F5;

selected-active-background: #946B8F;
selected-active-foreground: #B9B3F5;
selected-normal-background: #A59FE0;
selected-normal-foreground: #B9B3F5;
selected-urgent-background: #8C7198;
selected-urgent-foreground: #B9B3F5;

background-color: #000103;
background: rgba(0,0,0,0.7);
foreground: #CAC6E7;
border-color: #946B8F;
}

