 /* wallust template - colors-rofi */

* {
active-background: #A16C7C;
active-foreground: #DEAAD4;
normal-background: #010103;
normal-foreground: #DEAAD4;
urgent-background: #9F63B0;
urgent-foreground: #DEAAD4;

alternate-active-background: #A46089;
alternate-active-foreground: #DEAAD4;
alternate-normal-background: #010103;
alternate-normal-foreground: #DEAAD4;
alternate-urgent-background: #010103;
alternate-urgent-foreground: #DEAAD4;

selected-active-background: #A16C7C;
selected-active-foreground: #DEAAD4;
selected-normal-background: #C997C0;
selected-normal-foreground: #DEAAD4;
selected-urgent-background: #9F63B0;
selected-urgent-foreground: #DEAAD4;

background-color: #010103;
background: rgba(0,0,0,0.7);
foreground: #DCC2D7;
border-color: #A16C7C;
}

