 /* wallust template - colors-rofi */

* {
active-background: #488453;
active-foreground: #98D2A8;
normal-background: #030001;
normal-foreground: #98D2A8;
urgent-background: #6E8337;
urgent-foreground: #98D2A8;

alternate-active-background: #AA631F;
alternate-active-foreground: #98D2A8;
alternate-normal-background: #030001;
alternate-normal-foreground: #98D2A8;
alternate-urgent-background: #030001;
alternate-urgent-foreground: #98D2A8;

selected-active-background: #488453;
selected-active-foreground: #98D2A8;
selected-normal-background: #87C097;
selected-normal-foreground: #98D2A8;
selected-urgent-background: #6E8337;
selected-urgent-foreground: #98D2A8;

background-color: #030001;
background: rgba(0,0,0,0.7);
foreground: #BAD7C2;
border-color: #488453;
}

