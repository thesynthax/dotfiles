 /* wallust template - colors-rofi */

* {
active-background: #485950;
active-foreground: #919B9B;
normal-background: #020100;
normal-foreground: #919B9B;
urgent-background: #535658;
urgent-foreground: #919B9B;

alternate-active-background: #5A564F;
alternate-active-foreground: #919B9B;
alternate-normal-background: #020100;
alternate-normal-foreground: #919B9B;
alternate-urgent-background: #020100;
alternate-urgent-foreground: #919B9B;

selected-active-background: #485950;
selected-active-foreground: #919B9B;
selected-normal-background: #757E7E;
selected-normal-foreground: #919B9B;
selected-urgent-background: #535658;
selected-urgent-foreground: #919B9B;

background-color: #020100;
background: rgba(0,0,0,0.7);
foreground: #B1B6B6;
border-color: #485950;
}

