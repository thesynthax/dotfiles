set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#000103"
set completion-fg "#B9B3F5"
set completion-group-bg "#000103"
set completion-group-fg "#B9B3F5"
set completion-highlight-bg "#B9B3F5"
set completion-highlight-fg "#000103"

set recolor-lightcolor "#000103"
set recolor-darkcolor "#B9B3F5"
set default-bg "#808081"
set default-fg "#B9B3F5"
set inputbar-bg "#000103"
set inputbar-fg "#B9B3F5"
set notification-bg "#000103"
set notification-fg "#B9B3F5"
set notification-error-bg "#946B8F"
set notification-error-fg "#B9B3F5"
set notification-warning-bg "#946B8F"
set notification-warning-fg "#B9B3F5"
set statusbar-bg "#4C4D4F"
set statusbar-fg "#D4D1F2"
set index-bg "#5D78A4"
set index-fg "#B9B3F5"
set index-active-bg "#B9B3F5"
set index-active-fg "#000103"
set render-loading-bg "#000103"
set render-loading-fg "#B9B3F5"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

