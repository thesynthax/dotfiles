set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#010103"
set completion-fg "#96A7E5"
set completion-group-bg "#010103"
set completion-group-fg "#96A7E5"
set completion-highlight-bg "#96A7E5"
set completion-highlight-fg "#010103"

set recolor-lightcolor "#010103"
set recolor-darkcolor "#96A7E5"
set default-bg "#808081"
set default-fg "#96A7E5"
set inputbar-bg "#010103"
set inputbar-fg "#96A7E5"
set notification-bg "#010103"
set notification-fg "#96A7E5"
set notification-error-bg "#826074"
set notification-error-fg "#96A7E5"
set notification-warning-bg "#826074"
set notification-warning-fg "#96A7E5"
set statusbar-bg "#4D4D4F"
set statusbar-fg "#C2CBEA"
set index-bg "#656E89"
set index-fg "#96A7E5"
set index-active-bg "#96A7E5"
set index-active-fg "#010103"
set render-loading-bg "#010103"
set render-loading-fg "#96A7E5"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

