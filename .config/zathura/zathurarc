set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#010103"
set completion-fg "#ED93B9"
set completion-group-bg "#010103"
set completion-group-fg "#ED93B9"
set completion-highlight-bg "#ED93B9"
set completion-highlight-fg "#010103"

set recolor-lightcolor "#010103"
set recolor-darkcolor "#ED93B9"
set default-bg "#808081"
set default-fg "#ED93B9"
set inputbar-bg "#010103"
set inputbar-fg "#ED93B9"
set notification-bg "#010103"
set notification-fg "#ED93B9"
set notification-error-bg "#97626A"
set notification-error-fg "#ED93B9"
set notification-warning-bg "#97626A"
set notification-warning-fg "#ED93B9"
set statusbar-bg "#4D4D4F"
set statusbar-fg "#EEC1D4"
set index-bg "#8A6A8E"
set index-fg "#ED93B9"
set index-active-bg "#ED93B9"
set index-active-fg "#010103"
set render-loading-bg "#010103"
set render-loading-fg "#ED93B9"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

