set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#010103"
set completion-fg "#87A9D7"
set completion-group-bg "#010103"
set completion-group-fg "#87A9D7"
set completion-highlight-bg "#87A9D7"
set completion-highlight-fg "#010103"

set recolor-lightcolor "#010103"
set recolor-darkcolor "#87A9D7"
set default-bg "#808081"
set default-fg "#87A9D7"
set inputbar-bg "#010103"
set inputbar-fg "#87A9D7"
set notification-bg "#010103"
set notification-fg "#87A9D7"
set notification-error-bg "#77637F"
set notification-error-fg "#87A9D7"
set notification-warning-bg "#77637F"
set notification-warning-fg "#87A9D7"
set statusbar-bg "#4D4D4F"
set statusbar-fg "#BBCCE3"
set index-bg "#5F638D"
set index-fg "#87A9D7"
set index-active-bg "#87A9D7"
set index-active-fg "#010103"
set render-loading-bg "#010103"
set render-loading-fg "#87A9D7"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

