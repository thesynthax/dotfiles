set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#030001"
set completion-fg "#98D2A8"
set completion-group-bg "#030001"
set completion-group-fg "#98D2A8"
set completion-highlight-bg "#98D2A8"
set completion-highlight-fg "#030001"

set recolor-lightcolor "#030001"
set recolor-darkcolor "#98D2A8"
set default-bg "#818080"
set default-fg "#98D2A8"
set inputbar-bg "#030001"
set inputbar-fg "#98D2A8"
set notification-bg "#030001"
set notification-fg "#98D2A8"
set notification-error-bg "#488453"
set notification-error-fg "#98D2A8"
set notification-warning-bg "#488453"
set notification-warning-fg "#98D2A8"
set statusbar-bg "#4F4C4D"
set statusbar-fg "#C3E0CB"
set index-bg "#9A6F38"
set index-fg "#98D2A8"
set index-active-bg "#98D2A8"
set index-active-fg "#030001"
set render-loading-bg "#030001"
set render-loading-fg "#98D2A8"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

