set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#010103"
set completion-fg "#DEAAD4"
set completion-group-bg "#010103"
set completion-group-fg "#DEAAD4"
set completion-highlight-bg "#DEAAD4"
set completion-highlight-fg "#010103"

set recolor-lightcolor "#010103"
set recolor-darkcolor "#DEAAD4"
set default-bg "#808081"
set default-fg "#DEAAD4"
set inputbar-bg "#010103"
set inputbar-fg "#DEAAD4"
set notification-bg "#010103"
set notification-fg "#DEAAD4"
set notification-error-bg "#A16C7C"
set notification-error-fg "#DEAAD4"
set notification-warning-bg "#A16C7C"
set notification-warning-fg "#DEAAD4"
set statusbar-bg "#4D4D4F"
set statusbar-fg "#E6CCE1"
set index-bg "#6476A6"
set index-fg "#DEAAD4"
set index-active-bg "#DEAAD4"
set index-active-fg "#010103"
set render-loading-bg "#010103"
set render-loading-fg "#DEAAD4"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

