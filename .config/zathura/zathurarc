set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#030000"
set completion-fg "#DF938E"
set completion-group-bg "#030000"
set completion-group-fg "#DF938E"
set completion-highlight-bg "#DF938E"
set completion-highlight-fg "#030000"

set recolor-lightcolor "#030000"
set recolor-darkcolor "#DF938E"
set default-bg "#818080"
set default-fg "#DF938E"
set inputbar-bg "#030000"
set inputbar-fg "#DF938E"
set notification-bg "#030000"
set notification-fg "#DF938E"
set notification-error-bg "#714748"
set notification-error-fg "#DF938E"
set notification-warning-bg "#714748"
set notification-warning-fg "#DF938E"
set statusbar-bg "#4F4C4C"
set statusbar-fg "#E7C1BE"
set index-bg "#7E5D5F"
set index-fg "#DF938E"
set index-active-bg "#DF938E"
set index-active-fg "#030000"
set render-loading-bg "#030000"
set render-loading-fg "#DF938E"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

