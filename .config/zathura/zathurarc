set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#020100"
set completion-fg "#919B9B"
set completion-group-bg "#020100"
set completion-group-fg "#919B9B"
set completion-highlight-bg "#919B9B"
set completion-highlight-fg "#020100"

set recolor-lightcolor "#020100"
set recolor-darkcolor "#919B9B"
set default-bg "#808080"
set default-fg "#919B9B"
set inputbar-bg "#020100"
set inputbar-fg "#919B9B"
set notification-bg "#020100"
set notification-fg "#919B9B"
set notification-error-bg "#485950"
set notification-error-fg "#919B9B"
set notification-warning-bg "#485950"
set notification-warning-fg "#919B9B"
set statusbar-bg "#4E4D4C"
set statusbar-fg "#C0C5C5"
set index-bg "#5B5260"
set index-fg "#919B9B"
set index-active-bg "#919B9B"
set index-active-fg "#020100"
set render-loading-bg "#020100"
set render-loading-fg "#919B9B"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

