set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#010102"
set completion-fg "#9E9EA0"
set completion-group-bg "#010102"
set completion-group-fg "#9E9EA0"
set completion-highlight-bg "#9E9EA0"
set completion-highlight-fg "#010102"

set recolor-lightcolor "#010102"
set recolor-darkcolor "#9E9EA0"
set default-bg "#808080"
set default-fg "#9E9EA0"
set inputbar-bg "#010102"
set inputbar-fg "#9E9EA0"
set notification-bg "#010102"
set notification-fg "#9E9EA0"
set notification-error-bg "#48474A"
set notification-error-fg "#9E9EA0"
set notification-warning-bg "#48474A"
set notification-warning-fg "#9E9EA0"
set statusbar-bg "#4D4D4E"
set statusbar-fg "#C6C6C7"
set index-bg "#4C494C"
set index-fg "#9E9EA0"
set index-active-bg "#9E9EA0"
set index-active-fg "#010102"
set render-loading-bg "#010102"
set render-loading-fg "#9E9EA0"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

